<%- include('../template/header'); %>
<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1><%= heading %></h1>
        </div>
      </div>
    </div>
    <!-- /.container-fluid -->
  </section>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <% if(message){ %>
      <div class="alert alert-<%= message.type; %> alert-dismissible fade show" role="alert">
        <strong><%= message.message; %></strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <% } %>
      <!-- SELECT2 EXAMPLE -->
      <div class="card card-default">
        <div class="card-header">
          <h3 class="card-title font-weight-bold"><%= sub_heading %></h3>
          <div class="card-tools">
            <a href="/admin/shift_device" class="btn btn-warning btn-sm font-weight-bold">
              <i class="fas fa-sync-alt mr-1"></i> Shift Device Panel
            </a>
          </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
          <form action="/request_edit" method="post">
            <div class="row" id="divToPrint">
              <div class="col-md-12">
                <table id="example2" class="table table-bordered table-hover table-striped">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Phone No</th>
                      <th>Customer ID</th>
                      <th>Name</th>
                      <th>Device Status</th>
                      <th>Terms</th>
                      <th>Last Login</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(req_dt.suc > 0){ var i = 1; req_dt.msg.forEach((dt) =>
                    { %>
                    <tr>
                      <td><%= i %></td>
                      <td class="font-weight-bold"><%= dt.USER_CD %></td>
                      <td><%= dt.CUST_CD %></td>
                      <td><%= dt.USER_NAME %></td>
                      <td>
                        <% if (dt.DEVICE_ID && dt.DEVICE_ID !== 'null' && dt.DEVICE_ID !== '') { %>
                          <span class="badge badge-success px-2 py-1"><i class="fas fa-lock mr-1"></i> Bound (<%= dt.DEVICE_TYPE || 'Device' %>)</span>
                        <% } else { %>
                          <span class="badge badge-warning px-2 py-1"><i class="fas fa-unlock mr-1"></i> Ready for New Device</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (dt.TERMS_ACCEPTED === 'Y') { %>
                          <span class="badge badge-info">Agreed</span>
                        <% } else { %>
                          <span class="badge badge-warning">Pending</span>
                        <% } %>
                      </td>
                      <td><%= dt.LAST_LOGIN ? dateFormat(dt.LAST_LOGIN, "dd/mm/yyyy") : '' %></td>
                      <td>
                        <% if (dt.DEVICE_ID && dt.DEVICE_ID !== 'null' && dt.DEVICE_ID !== '') { %>
                          <a href="reset_device?id=<%= dt.USER_CD %>" onclick="return confirm('Are you sure you want to shift/reset device binding for <%= dt.USER_NAME %> (<%= dt.USER_CD %>)? The member will be able to bind their new phone on next login.');" class="btn btn-warning btn-sm font-weight-bold" title="Shift / Release Device Binding">
                            <i class="fas fa-sync-alt mr-1"></i> Shift Device
                          </a>
                        <% } %>
                        <a href="user_delete?id=<%= dt.USER_CD %>" onclick="return deleteUser();" class="btn btn-danger btn-sm">
                          <i class="fas fa-trash-alt mr-1"></i> Delete
                        </a>
                      </td>
                    </tr>
                    <% i++; }) }else{ %>
                    <tr>
                      <td colspan="8" class="text-center">No data found</td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </form>
        </div>
      </div>
      <!-- /.card -->
    </div>
    <!-- /.container-fluid -->
  </section>
  <!-- /.content -->
</div>
<!-- /.content-wrapper -->
<%- include('../template/footer'); %>

<script>
  $(function() {
	  $("#example2").DataTable({
      paging: true,
      lengthChange: false,
      searching: true,
      ordering: true,
      info: true,
      autoWidth: false,
      responsive: true,
      buttons: ["csv", "excel", "pdf"]
    }).buttons().container().appendTo('#example2_wrapper .col-md-6:eq(0)');
  });

  function deleteUser(){
      return confirm('Are you sure you want to delete this user permanently?');
  }
</script>
